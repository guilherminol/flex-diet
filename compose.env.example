# Modelo do compose.env — o arquivo REAL vive só na VPS, ao lado do docker-compose.yml
# (gitignored; nunca versionado — dados de saúde e segredo fora do git, T-01-13).
# Na VPS: cp compose.env.example compose.env && preencha os 3 valores.

# Token Bearer exigido pelo /mcp — gere 32+ bytes aleatórios, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# Porta publicada no HOST pela VPS (${PORT:-8787} no compose).
# Dentro do container o serviço SEMPRE escuta em 8787 (healthcheck e mapeamento
# fixam o lado interno em 8787) — mantenha PORT=8787 a menos que saiba o que está fazendo.
PORT=8787

# Domínio ou IP pelo qual o Hermes alcança a VPS — alimenta allowedHosts do
# servidor (sem isso o próprio servidor responde 403 ao Hermes, RESEARCH Pitfall 4).
PUBLIC_HOST=
